# Contrato de configuração para o Coolify. Os valores reais vivem no Coolify, por app.
# Nunca commitar este ficheiro preenchido.

# Password do primeiro admin (utilizador "admin", ou TRACKER_USERNAME).
# Sem esta variável, o primeiro arranque imprime um setup code no log e o primeiro
# visitante cria a conta — não deixar assim numa app pública.
TRACKER_PASSWORD=

# Passphrase que cifra as credenciais guardadas (OAuth do ChatGPT, chaves da Mistral/OpenCode).
# Gerar com: openssl rand -base64 32
# Se faltar, é criada uma chave aleatória em /data/secret.key e passa a ser preciso
# restaurar esse ficheiro junto com a base de dados.
TRACKER_SECRET_KEY=

# URL pública: marca os cookies como Secure e é usada nas instruções de push.
TRACKER_PUBLIC_URL=https://uso.example.com

# Atrás do Traefik do Coolify, para o rate-limit de login ver o IP real.
TRACKER_TRUST_PROXY=true

# Intervalo de polling (mínimo 1m). Uma vez guardado na UI, o valor da UI ganha.
TRACKER_POLL_INTERVAL=2m

TRACKER_DATA_DIR=/data
